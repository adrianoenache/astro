---
// Base URL for constructing links dynamically
const base = import.meta.env.BASE_URL;

// Define the menu items with dynamic base URL for each link
const menu = [
	{ name: "Home", href: `${base}` },
	{ name: "About", href: `${base}about` },
	{ name: "Blog", href: `${base}blog` },
	{ name: "TAGs", href: `${base}tags` },
	{ name: "Welcome", href: `${base}welcome` },
];
---

<nav aria-label="Main menu">
	<ul>
		{menu
			.filter((item) => item.href?.trim() && item.name?.trim())
			.map((item) => (
				<li>
					<a href={item.href}>{item.name}</a>
				</li>
			))}
	</ul>
</nav>
