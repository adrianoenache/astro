---
// MenuBlog component: lists blog posts sorted by publish date

// Imports and type definitions for the component
import type { PostFrontmatter } from "../../../../types/PostFrontmatter";

// Type definition for a Markdown post with frontmatter and optional URL
interface MarkdownPost {
	url?: string; // Optional URL of the post
	frontmatter: PostFrontmatter; // Frontmatter metadata of the post
}

// Import all Markdown posts from the posts directory
const matches = import.meta.glob("../../../../pages/posts/*.md", {
	eager: true,
});

// Function to sort posts by publish date in descending order
const sortByPublishDateDesc = (a: MarkdownPost, b: MarkdownPost) =>
	new Date(b.frontmatter.pubDate).getTime() -
	new Date(a.frontmatter.pubDate).getTime();

// Filter and sort the posts
const posts = (Object.values(matches) as MarkdownPost[])
	.filter((post) => post.url && post.frontmatter?.title)
	.sort(sortByPublishDateDesc);
---

<nav aria-label="Listagem dos posts do blog">
	{posts.length > 0 ? (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={post.url}>{post.frontmatter.title}</a>
				</li>
			))}
		</ul>
	) : (
		<p>Nenhuma postagem encontrada.</p>
	)}
</nav>
