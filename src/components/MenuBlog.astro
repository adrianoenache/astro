---
const menuBlog = [
	{ name: "Minha Primeira Postagem no Blog", href: "/posts/post-1" },
	{ name: "Minha Segunda Postagem no Blog", href: "/posts/post-2" },
	{ name: "Minha Terceira Postagem no Blog", href: "/posts/post-3" }
];
---

<nav>
  <ul>
    {menuBlog
      .filter((item) => item.href?.trim() && item.name?.trim())
      .map((item) => (
        <li>
          <a href={item.href}>{item.name}</a>
        </li>
      ))}
  </ul>
</nav>
