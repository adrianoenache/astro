---
// Layout component for the application, handling the HTML structure and head elements.

// Props for the layout component.
// pageLang: The language of the page, defaulting to "pt-BR".
// pageTitle: The title of the page.
// pageDescription: The description of the page.
// pageKeywords: The keywords for the page.
export interface Props {
	pageLang?: string;
	pageTitle?: string;
	pageDescription?: string;
	pageKeywords?: string;
}
const { pageLang = "pt-BR" } = Astro.props;

// Styles
import "../styles/global.css";

// Components
import HeadSEO from "../components/head/HeadSEO.astro";
import HeadStyleCriticalCSS from "../components/head/HeadStyleCriticalCSS.astro";
import Menu from "../components/Menu.astro";
---

<!doctype html>
<html lang={pageLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<HeadSEO pageTitle={Astro.props.pageTitle} pageDescription={Astro.props.pageDescription} pageKeywords={Astro.props.pageKeywords} />
		<HeadStyleCriticalCSS />
		<slot name="custom-styles" />
	</head>
	<body>
		<main>
			<Menu />
			<slot />
		</main>
	</body>
</html>
