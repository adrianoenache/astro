---
// Main Layout component for the application, handling the HTML structure and head elements.

// Components
import HeadDefault from "../components/head/HeadDefault.astro";
import HeadSEO from "../components/head/HeadSEO.astro";
import HeadFavicon from "../components/head/HeadFavicon.astro";
import HeadStyleCriticalCSS from "../components/head/HeadStyleCriticalCSS.astro";
import Menu from "../components/Menu.astro";

// Styles
import "../styles/global.css";

// Props for the layout component.
// pageLang: The language of the page, defaulting to "pt-BR".
// pageTitle: The title of the page.
// pageDescription: The description of the page.
// pageKeywords: The keywords for the page.

export interface Props {
	pageLang?: string;
	pageTitle?: string;
	pageDescription?: string;
	pageKeywords?: string;
}

const { pageLang = "pt-BR" } = Astro.props;
const { pageTitle, pageDescription, pageKeywords } = Astro.props;
---

<!DOCTYPE html>
<html lang={pageLang}>
	<head>
		<HeadDefault />
		<HeadFavicon />
		<HeadSEO pageTitle={pageTitle} pageDescription={pageDescription} pageKeywords={pageKeywords} />
		<HeadStyleCriticalCSS />
		<slot name="custom-styles" />
	</head>
	<body>
		<main>
			<Menu />
			<slot />
		</main>
		<slot name="custom-scripts" />
		<script>
			import('../scripts/layout.mjs');
		</script>
	</body>
</html>
