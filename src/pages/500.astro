---
// Import components for the page.
import MainLayout from "../layouts/MainLayout.astro";

// Props for the page.
interface Props {
  error: unknown;
}
const { error } = Astro.props;
const pageTitle = "Erro Interno do Servidor - Error 500";
const pageDescription = "Erro Interno do Servidor - Error 500";
---

<MainLayout
	pageTitle={pageTitle}
	pageDescription={pageDescription}
>
	<h1>{pageTitle}</h1>
	<p>{error instanceof Error ? error.message : "Erro desconhecido"}</p>
</MainLayout>
