---
// Import components for the page.
import MainLayout from "../layouts/MainLayout.astro";
import Text from "../components/atomic-design/atoms/text/Text.astro";

// Props for the page.
const pageTitle = "Meu Site Astro";
const pageDescription = "Meu Site Astro";
---

<MainLayout
	pageTitle={pageTitle}
	pageDescription={pageDescription}
>

	<Text tag="h1">
		{pageTitle}
		<slot name="text-after">
			<br />
			<Text tag="span">
				Lorem ipsum dolor.
			</Text>
		</slot>
	</Text>
	<Fragment name="custom-scripts">
		<Text tag="p">Este é um parágrafo de exemplo.</Text>
		<script type="module">
			console.warn('Olá Astro!')
		</script>
	</Fragment>
</MainLayout>
