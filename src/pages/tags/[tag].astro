---
// Tag page for displaying posts associated with a specific tag.

// Imports and type definitions for the tag page
import MainLayout from "../../layouts/MainLayout.astro";
import Text from "../../components/atomic-design/atoms/text/Text.astro";

// Imports and type definitions for the tag page
import type { PostFrontmatter } from "../../types/PostFrontmatter";

// Interface for a markdown post with frontmatter and optional URL.
interface MarkdownPost {
	url?: string;
	frontmatter: PostFrontmatter;
}

// Interface for the tag page props
interface TagPageProps {
	posts: MarkdownPost[];
}

// Sort posts by publish date in descending order.
const sortByPublishDateDesc = (a: MarkdownPost, b: MarkdownPost) =>
	new Date(b.frontmatter.pubDate).getTime() -
	new Date(a.frontmatter.pubDate).getTime();

// Generate static paths for each tag found in the posts
export async function getStaticPaths() {
	const matches = import.meta.glob("../posts/*.md", {
		eager: true,
	});

	// Convert the imported markdown files into an array of posts
	const posts = Object.values(matches) as MarkdownPost[];

	// Extract all unique tags from the posts
	const tags = [
		...new Set(posts.flatMap((post) => post.frontmatter.tags ?? [])),
	];

	return tags.map((tag) => ({
		params: { tag },
		props: { posts },
	}));
}

const tag = Astro.params.tag ?? "";

// Get posts from props
const { posts } = Astro.props as TagPageProps;

// Filter and sort posts by the current tag
const filteredPosts = posts
	.filter(
		(post) =>
			post.url && post.frontmatter.title && post.frontmatter.tags.includes(tag),
	)
	.sort(sortByPublishDateDesc);
---

<MainLayout
	pageTitle={`Tag: ${tag}`}
	pageDescription={`Posts relacionados à tag ${tag}`}
>
	<Text tag="h1">Posts com a tag: {tag}</Text>

	<nav aria-label={`Posts com a tag ${tag}`}>
		{filteredPosts.length > 0 ? (
			<ul>
				{filteredPosts.map((post) => (
					<li>
						<a href={post.url}>{post.frontmatter.title}</a>
					</li>
				))}
			</ul>
		) : (
			<Text tag="p">Nenhuma postagem encontrada para esta tag.</Text>
		)}
	</nav>
</MainLayout>
