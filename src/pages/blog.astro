---
// Import components for the page.
import MainLayout from "../layouts/MainLayout.astro";
import MenuBlog from "../components/MenuBlog.astro";
import Text from "../components/atomic-design/atoms/text/Text.astro";

// Props for the page.
const pageTitle = "Blog Astro";
const pageDescription = "Blog Astro";
---

<MainLayout
	pageTitle={pageTitle}
	pageDescription={pageDescription}
	pageKeywords="Blog, Astro"
>
	<Text tag="h1">{pageTitle}</Text>
	<MenuBlog />
</MainLayout>
