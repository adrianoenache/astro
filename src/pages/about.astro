---
// Import components for the page.
import MainLayout from "../layouts/MainLayout.astro";
import Text from "../components/atomic-design/atoms/text/Text.astro";

// Props for the page.
const pageTitle = "Sobre Mim";
const pageDescription = "Sobre Mim";
const identify = {
	firstName: "Sarah",
	country: "Canadá",
	occupation: "Escritora Técnica",
	hobbies: ["fotografia", "observar pássaros", "beisebol"],
};
const skills = [
	"HTML",
	"CSS",
	"JavaScript",
	"React",
	"Astro",
	"Escrever Documentação",
];
const happy = true;
const finished = true;
const goal = 3;
const skillColor = "navy";
const skillFontWeight = "bold";
const skillTextCase = "uppercase";
---

<MainLayout
	pageTitle={pageTitle}
	pageDescription={pageDescription}
>
	<style define:vars={{skillColor, skillFontWeight, skillTextCase}}>
		.skill {
			color: var(--skillColor);
			font-weight: var(--skillFontWeight);
			text-transform: var(--skillTextCase);
		}
	</style>
	<Text tag="h1">{pageTitle}</Text>
	<Text tag="p">Aqui estão alguns fatos sobre mim:</Text>
	<ul>
		<li>Meu nome é {identify.firstName}.</li>
		<li>
			Eu moro no {identify.country} e eu trabalho como uma {
				identify.occupation
			}.
		</li>
		{
			identify.hobbies.length >= 2 && (
				<li>
					Dois dos meus hobbies são: {identify.hobbies[0]} and{" "}
					{identify.hobbies[1]}
				</li>
			)
		}
	</ul>
	<Text tag="p">Minhas habilidades são:</Text>
	<ul>
		{skills.map((habilidade) => <li class="skill">{habilidade}</li>)}
	</ul>
	{happy && <Text tag="p">Estou feliz em estar aprendendo Astro!</Text>}

	{finished && <Text tag="p">Eu terminei esse tutorial!</Text>}

	{
		goal === 3 ? (
			<Text tag="p">Minha meta é terminar em 3 dias.</Text>
		) : (
			<Text tag="p">Minha meta não é em 3 dias.</Text>
		)
	}
</MainLayout>
